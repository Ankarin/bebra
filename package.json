{
  "name": "glaife",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "bun run --filter=@glaife/web dev",
    "dev:all": "bun run --parallel --filter='*' dev",
    "build": "bun run --filter='*' build",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "typescript": "^5.9.3"
  }
}
